			"label": "Identify storefront dev process",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -State Listen -LocalPort 3002 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stop broken storefront process",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Stop-Process -Id 37604 -Force"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Clear broken Next build cache",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"$cache = 'C:\\Users\\vaibh\\Appscrip-FullStack-Assignment\\frontend\\.next'; if (Test-Path -LiteralPath $cache) { Remove-Item -LiteralPath $cache -Recurse -Force }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Clear Next generated cache",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"require('node:fs').rmSync('frontend/.next',{recursive:true,force:true})"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove stale Next artifacts",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"rmdir /s /q frontend\\.next"
			],
			"isBackground": false,
			"problemMatcher": []
		},
